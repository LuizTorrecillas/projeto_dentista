# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# O .env fica só no seu computador (está no .gitignore) e NUNCA vai para o GitHub.

# Chave usada para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere uma chave aleatória com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ela vazar, quem tiver a chave consegue forjar um login: gere outra.
CLINICA_CHAVE_SECRETA=

# Use true SOMENTE quando o sistema for acessado por HTTPS.
# Em http://127.0.0.1 deixe false, senão o navegador não envia o cookie e o login não funciona.
CLINICA_COOKIE_SECURE=false

# Tempo (em horas) que a sessão dura sem uso antes de pedir login de novo.
CLINICA_SESSAO_HORAS=8

# Caminho do arquivo do banco (opcional). Padrão: dados/clinica.db.
# Caminho relativo é contado a partir da raiz do projeto.
# CLINICA_DB=dados/clinica.db

# Quantos backups manter na pasta dados/backups/ (opcional). Padrão: 14.
# CLINICA_BACKUPS_MANTER=14
